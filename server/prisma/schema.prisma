generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  charts    Chart[]
}

model Chart {
  id          String      @id @default(uuid())
  name        String
  data        Json
  description String?
  status      ChartStatus @default(CURRENT)
  dateCreated DateTime    @default(now())
  // dateOpened  DateTime
  ownerId     String

  user User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

enum ChartStatus {
  CURRENT
  COMPLETED
}
